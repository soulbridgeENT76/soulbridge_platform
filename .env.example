# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Canonical site origin, no trailing slash (e.g. https://soulbridge-ent.com).
# Used for metadataBase, /sitemap.xml and /robots.txt. Keep this on the
# production origin so sitemap entries belong to the Search Console property.
NEXT_PUBLIC_SITE_URL=https://soulbridgeent.com
